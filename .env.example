# --- Required ---------------------------------------------------------------
# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram chat ID to send notifications to (use @userinfobot to get yours)
CHAT_ID=your_chat_id_here

# Holodex API key (primary live-detection source — recommended).
# Free key: sign in at https://holodex.net -> Account -> create API key.
HOLODEX_API_KEY=your_holodex_api_key_here

# --- Optional ---------------------------------------------------------------
# YouTube Data API v3 key. Only used as a fallback if Holodex is unavailable
# (or as the sole source if HOLODEX_API_KEY is empty). Costs 100 quota units
# per channel per check, so keep the interval high if relying on it.
YOUTUBE_API_KEY=

# Seconds between live checks (default 120). Holodex is cheap, so 60-120 is fine.
CHECK_INTERVAL_SECONDS=120

# Set to true to also alert for streams already live when the bot starts.
# Default false avoids an alert burst on every restart.
NOTIFY_ON_STARTUP=false
